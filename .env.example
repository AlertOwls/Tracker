NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: when both are set, the app requires login
TRACKER_AUTH_USERNAME=your-username
TRACKER_AUTH_PASSWORD=your-strong-password
# Recommended in production (signs session cookie; defaults to password if omitted)
TRACKER_AUTH_SECRET=random-long-secret-string
